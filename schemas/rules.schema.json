{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:security-analyzer-agent:schema:rules",
  "title": "rules.json (canvas section 8)",
  "description": "The shape of golden/rules.json. The orchestrator validates the rules file with this schema at the start of every run. Unique ids are checked in validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "note": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "fix_allowed", "detect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
        "severity": { "enum": ["low", "medium", "high"] },
        "fix_allowed": { "type": "boolean" },
        "detect": { "type": "string", "minLength": 1 },
        "min_versions": {
          "type": "object",
          "minProperties": 1,
          "description": "Package name to minimum version. Used by DEP-PIN.",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
        }
      }
    }
  }
}
