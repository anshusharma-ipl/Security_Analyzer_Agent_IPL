{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:security-analyzer-agent:schema:tool:run_security_rules",
  "title": "Tool run_security_rules (canvas section 9)",
  "description": "Used by: Auditor. Reads only. Runs the text-pattern security rules from the rules file on the files. Approved by: the security engineer, by writing the rule. If it fails: skip a faulty rule and note it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "arguments", "response"],
  "properties": {
    "tool": { "const": "run_security_rules" },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "rules_file", "files"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "rules_file": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } }
      }
    },
    "response": {
      "type": "object",
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "$ref": "#/$defs/success" },
      "else": { "$ref": "#/$defs/failure" }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$)).+$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "result"],
      "properties": {
        "ok": { "const": true },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matches", "skipped_rules"],
          "properties": {
            "sensitive_items_hidden": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional. How many secrets, emails and phone numbers were replaced by placeholders in quoted_code. The orchestrator adds these up for the run record."
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule_id", "file", "line", "quoted_code"],
                "properties": {
                  "rule_id": { "$ref": "#/$defs/ruleId" },
                  "file": { "$ref": "#/$defs/path" },
                  "line": { "type": "integer", "minimum": 1 },
                  "quoted_code": { "type": "string", "pattern": "^[^\\r\\n]+$" }
                }
              }
            },
            "skipped_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule_id", "reason"],
                "properties": {
                  "rule_id": { "$ref": "#/$defs/ruleId" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            },
            "skipped_files": {
              "type": "array",
              "description": "Optional. Files that could not be scanned (unreadable, binary, or a link that leaves the project), so a gap is never silent.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "reason"],
                "properties": {
                  "file": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "handling"],
          "properties": {
            "code": { "enum": ["root_not_found", "rules_file_unreadable", "all_rules_failed"] },
            "message": { "type": "string", "minLength": 1 },
            "handling": { "const": "skip_rule_and_note" }
          }
        }
      }
    }
  }
}
